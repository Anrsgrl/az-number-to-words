{
  "name": "az-number-to-words",
  "version": "0.1.1",
  "description": "Convert numbers to Azerbaijani words, with manat/qəpik currency support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --declarationMap false --sourceMap false && node -e \"require('fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "azerbaijani",
    "azerbaijan",
    "manat",
    "azn",
    "number-to-words",
    "num2words",
    "i18n"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anrsgrl/az-number-to-words.git"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
